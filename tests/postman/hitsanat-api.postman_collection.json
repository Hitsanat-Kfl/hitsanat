                { "key": "search", "value": "", "description": "Search by name or phone" },
                { "key": "subDept", "value": "", "description": "Filter by sub-department ID" },
                { "key": "familyId", "value": "", "description": "Filter by family ID" },
                { "key": "yearOfStudy", "value": "", "description": "Filter by year of study" },
                { "key": "isActive", "value": "", "description": "Filter by active status" }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Response is array or paginated', () => {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json).to.satisfy(v => Array.isArray(v) || v.data || v.items);",
                  "});"
                ]
              }
            }
          ]
