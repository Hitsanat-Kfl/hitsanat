{
  "info": {
    "name": "Hitsanat Kifl API",
    "description": "Complete API test collection for Hitsanat Kifl Children's Ministry Management System\n\nBase URL: {{baseUrl}}\n\nAuthentication:\n- Sign in via POST /api/v1/auth/sign-in/email\n- Session cookie (better-auth.session_token) is auto-managed",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3001"
    }
  ],
  "auth": {
    "type": "apikey",
    "apikey": [
      {
        "key": "key",
        "value": "Cookie",
        "type": "string"
      },
      {
        "key": "value",
        "value": "{{sessionCookie}}",
        "type": "string"
      },
      {
        "key": "in",
        "value": "header",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "GET /health",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": ["{{baseUrl}}"],
              "path": ["health"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Response has status field', () => {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json).to.have.property('status');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Authentication",
      "item": [
        {
          "name": "POST /auth/sign-in/email",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/sign-in/email",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "sign-in", "email"]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"leader@hitsanat.org\",\n  \"password\": \"password123\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200 or 401', () => {",
                  "  pm.expect([200, 401]).to.include(pm.response.code);",
                  "});",
                  "if (pm.response.code === 200) {",
                  "  const cookies = pm.response.headers.filter(h => h.key === 'set-cookie');",
                  "  if (cookies.length > 0) {",
                  "    const sessionCookie = cookies[0].value.split(';')[0].split('=')[1];",
                  "    pm.environment.set('sessionCookie', sessionCookie);",
                  "  }",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /auth/sign-out",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/sign-out",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "sign-out"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": ["pm.test('Status is 200', () => pm.response.to.have.status(200));"]
              }
            }
          ]
        },
        {
          "name": "GET /auth/session",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/session",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "session"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200 or 401', () => {",
                  "  pm.expect([200, 401]).to.include(pm.response.code);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /auth/change-password",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/change-password",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "change-password"]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"currentPassword\": \"password123\",\n  \"newPassword\": \"newpassword456\"\n}"
            }
          }
        }
      ]
    },
    {
