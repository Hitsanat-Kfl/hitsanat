              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Test Member\",\n  \"christianName\": \"Test\",\n  \"phone\": \"+251911000001\",\n  \"yearOfStudy\": \"Year 1\",\n  \"academicDepartment\": \"Computer Science\",\n  \"campus\": \"Main\",\n  \"gender\": \"Male\"\n}"
