# Application & API
NODE_ENV=development
PORT=3001
API_PREFIX=/api/v1
CORS_ORIGIN=*

# Supabase (Authentication + Database)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# PostgreSQL Database (Supabase Pooler)
DATABASE_URL=postgresql://postgres.your-project:your-password@aws-1-eu-west-1.pooler.supabase.com:5432/postgres

# Integration Testing Database
TEST_DATABASE_URL=postgresql://postgres.your-project:your-password@aws-1-eu-west-1.pooler.supabase.com:5432/postgres

# Playwright Test URL
PLAYWRIGHT_TEST_BASE_URL=http://localhost:3000
